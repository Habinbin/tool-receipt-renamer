	},
	"devDependencies": {
		"@fontsource-variable/noto-sans-kr": "^5.3.0",
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24.10.1",
		"jszip": "^3.10.1",
