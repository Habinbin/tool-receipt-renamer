		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.app.json",
		"test": "vitest run",
		"bench": "tsx bench/run.ts",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"peerDependencies": {
		"@fontsource-variable/noto-sans-kr": "^5.3.0",
